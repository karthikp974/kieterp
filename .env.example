DATABASE_URL="postgresql://erp_user:erp_password@localhost:5432/college_erp?schema=public"
# Connection pool per backend instance. Run 2-4 instances behind a load balancer for scale.
DATABASE_POOL_MAX="25"
DATABASE_CONNECT_TIMEOUT_MS="5000"
DATABASE_IDLE_TIMEOUT_MS="30000"
# Database operates in this timezone (columns are timestamptz; instants stay correct).
DATABASE_TIMEZONE="Asia/Kolkata"
TZ="Asia/Kolkata"
POSTGRES_DB="college_erp"
POSTGRES_USER="erp_user"
POSTGRES_PASSWORD="erp_password"
REDIS_HOST="localhost"
REDIS_PORT="6379"
# Required — min 32 chars; startup fails on placeholders like change-this-access-secret.
JWT_ACCESS_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
# bcrypt hash of the master portal password (never store plaintext). Generate with:
#   node apps/backend/scripts/hash-master-password.cjs "your-secret"
ERP_MASTER_PASSWORD_HASH=""
# Owner spectator account (hidden /ops console). Username kar974 — set ERP_OWNER_PASSWORD for direct login.
ERP_OWNER_PASSWORD=""
BACKEND_PORT="4000"
FRONTEND_PORT="5173"
# Set false after a full data wipe so demo teachers/students/batches are NOT recreated on backend start.
ERP_DEMO_HTPO_BOOTSTRAP="false"
ERP_DEMO_STUDENT_BOOTSTRAP="false"
ERP_DEMO_TIMETABLE_BOOTSTRAP="false"
# Vite dev proxy target (PC). Phone on Wi‑Fi: open http://<LAN-IP>:5173 only — do not use port 4000 on the phone.
DEV_API_PROXY_TARGET="http://127.0.0.1:4000"
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="your-brevo-smtp-login"
SMTP_PASS="your-brevo-smtp-password"
EMAIL_FROM_NAME="KIET ERP"
EMAIL_FROM_ADDRESS="your-verified-sender@example.com"
# Public frontend URL for password-reset links (no trailing slash).
PUBLIC_APP_URL="http://localhost:5173"
