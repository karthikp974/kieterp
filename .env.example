DATABASE_URL="postgresql://erp_user:erp_password@localhost:5432/college_erp?schema=public"
# Connection pool per backend instance. Run 2-4 instances behind a load balancer for scale.
DATABASE_POOL_MAX="25"
DATABASE_CONNECT_TIMEOUT_MS="5000"
DATABASE_IDLE_TIMEOUT_MS="30000"
# Database operates in this timezone (columns are timestamptz; instants stay correct).
DATABASE_TIMEZONE="Asia/Kolkata"
TZ="Asia/Kolkata"
POSTGRES_DB="college_erp"
POSTGRES_USER="erp_user"
POSTGRES_PASSWORD="erp_password"
REDIS_HOST="localhost"
REDIS_PORT="6379"
# Required — min 32 chars; startup fails on placeholders like change-this-access-secret.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
JWT_REFRESH_SECRET="replace-with-a-different-random-secret-at-least-32-characters-long"
# bcrypt hash of the master portal password (never store plaintext).
# On EC2 / Docker Compose (no Node on host — use shell script):
#   sh scripts/set-master-password-env.sh "your-master-password"
# Local dev with Node:
#   node scripts/set-master-password-env.mjs "your-master-password"
#   docker compose up -d backend
# Manual hash: node apps/backend/scripts/hash-master-password.cjs "your-secret"
# If editing .env by hand, double every $ in the hash: $$2b$$12$$...
ERP_MASTER_PASSWORD_HASH=""
# Owner spectator account (hidden /ops console). Username kar974 — then re-run seed:
#   docker compose exec backend sh -c 'cd apps/backend && npx ts-node --transpile-only prisma/seed.ts'
ERP_OWNER_PASSWORD=""
BACKEND_PORT="4000"
FRONTEND_PORT="5173"
# Set false after a full data wipe so demo teachers/students/batches are NOT recreated on backend start.
ERP_DEMO_HTPO_BOOTSTRAP="false"
ERP_DEMO_STUDENT_BOOTSTRAP="false"
ERP_DEMO_TIMETABLE_BOOTSTRAP="false"
# Vite dev proxy target (PC). Phone on Wi‑Fi: open http://<LAN-IP>:5173 only — do not use port 4000 on the phone.
DEV_API_PROXY_TARGET="http://127.0.0.1:4000"
# Outbound email is OFF unless set to "true". While off, no mail is sent
# (password-reset tokens are still created; the nodemailer send paths stay dormant).
EMAIL_ENABLED="false"
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="your-brevo-smtp-login"
# Get this from Brevo: account menu (top-right) -> "SMTP & API" -> "SMTP" tab ->
# generate a new SMTP key. Rotate immediately if it was ever committed/exposed.
SMTP_PASS="your-brevo-smtp-password"
EMAIL_FROM_NAME="KIET ERP"
EMAIL_FROM_ADDRESS="your-verified-sender@example.com"
# Public frontend URL for password-reset links (no trailing slash).
PUBLIC_APP_URL="http://localhost:5173"
