{
  "name": "@college-erp/backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "dotenv -e ../../.env -- ts-node -r tsconfig-paths/register src/main.ts",
    "dev:watch": "dotenv -e ../../.env -- nodemon --watch src --ext ts --exec ts-node -r tsconfig-paths/register src/main.ts",
    "worker": "ts-node -r tsconfig-paths/register src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "prisma:migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:studio": "dotenv -e ../../.env -- prisma studio",
    "seed": "dotenv -e ../../.env -- ts-node prisma/seed.ts",
    "db:clear-operational": "dotenv -e ../../.env -- ts-node prisma/clear-operational-data.ts",
    "migrate:timetable-times": "dotenv -e ../../.env -- node scripts/migrate-timetable-times.cjs"
  },
  "dependencies": {
    "@nestjs/bullmq": "latest",
    "@nestjs/common": "latest",
    "@nestjs/config": "latest",
    "@nestjs/core": "latest",
    "@nestjs/jwt": "latest",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "latest",
    "@nestjs/platform-express": "latest",
    "@prisma/adapter-pg": "latest",
    "@prisma/client": "latest",
    "bcrypt": "^6.0.0",
    "bullmq": "latest",
    "class-transformer": "latest",
    "class-validator": "latest",
    "exceljs": "^4.4.0",
    "helmet": "^8.2.0",
    "ioredis": "latest",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.7",
    "passport": "latest",
    "passport-jwt": "latest",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.18.0",
    "pg": "latest",
    "reflect-metadata": "latest",
    "rxjs": "latest"
  },
  "devDependencies": {
    "@angular-devkit/schematics": "^18.2.21",
    "@nestjs/cli": "latest",
    "@nestjs/schematics": "latest",
    "@nestjs/testing": "latest",
    "@types/bcrypt": "^6.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "latest",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "latest",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "latest",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "dotenv-cli": "^11.0.0",
    "eslint": "latest",
    "prisma": "latest",
    "source-map-support": "latest",
    "ts-node": "latest",
    "tsconfig-paths": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
